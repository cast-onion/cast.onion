{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "types": ["node", "svelte", "@sveltejs/kit"],
    "moduleResolution": "bundler"
  },
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}